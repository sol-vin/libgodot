[configuration]
entry_symbol = "crystal_library_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/crystal_bridge.so"
linux.release.x86_64 = "res://bin/crystal_bridge.so"
windows.debug.x86_64 = "res://bin/crystal_bridge.dll"
windows.release.x86_64 = "res://bin/crystal_bridge.dll"
macos.debug = "res://bin/crystal_bridge.dylib"
macos.release = "res://bin/crystal_bridge.dylib"
macos.debug.arm64 = "res://bin/crystal_bridge.dylib"
macos.release.arm64 = "res://bin/crystal_bridge.dylib"
macos.debug.x86_64 = "res://bin/crystal_bridge.dylib"
macos.release.x86_64 = "res://bin/crystal_bridge.dylib"
android.debug.arm64 = "res://bin/android/arm64-v8a/libcrystal_bridge.so"
android.release.arm64 = "res://bin/android/arm64-v8a/libcrystal_bridge.so"

[dependencies]
macos.debug = { "res://bin/game.dylib": "" }
macos.release = { "res://bin/game.dylib": "" }
macos.debug.arm64 = { "res://bin/game.dylib": "" }
macos.release.arm64 = { "res://bin/game.dylib": "" }
macos.debug.x86_64 = { "res://bin/game.dylib": "" }
macos.release.x86_64 = { "res://bin/game.dylib": "" }
android.debug.arm64 = { "res://bin/android/arm64-v8a/libgame.so": "" }
android.release.arm64 = { "res://bin/android/arm64-v8a/libgame.so": "" }

